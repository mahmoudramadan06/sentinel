{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "semgrep",
          "rules": [
            {
              "id": "python.lang.security.audit.eval-detected.eval-detected",
              "name": "eval-detected",
              "shortDescription": {"text": "Detected the use of eval()"},
              "fullDescription": {"text": "eval() can execute arbitrary code and is dangerous when input is user-controlled."},
              "help": {"text": "Remove eval() and use ast.literal_eval or an explicit parser."}
            },
            {
              "id": "python.lang.security.audit.subprocess-shell-true.subprocess-shell-true",
              "name": "subprocess-shell-true",
              "shortDescription": {"text": "Detected subprocess with shell=True"},
              "fullDescription": {"text": "shell=True passes the command through a shell, enabling command injection."},
              "help": {"text": "Use an argument list with shell=False."}
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "python.lang.security.audit.eval-detected.eval-detected",
          "level": "error",
          "message": {"text": "Detected the use of eval()."},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "app.py"},
                "region": {"startLine": 41, "snippet": {"text": "return eval(expr)"}}
              }
            }
          ]
        },
        {
          "ruleId": "python.lang.security.audit.eval-detected.eval-detected",
          "level": "error",
          "message": {"text": "Detected the use of eval()."},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "app.py"},
                "region": {"startLine": 41, "snippet": {"text": "return eval(expr)"}}
              }
            }
          ]
        },
        {
          "ruleId": "python.lang.security.audit.subprocess-shell-true.subprocess-shell-true",
          "level": "warning",
          "message": {"text": "Detected subprocess with shell=True."},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "app.py"},
                "region": {"startLine": 37, "snippet": {"text": "subprocess.run(\"generate-report \" + report_name, shell=True)"}}
              }
            }
          ]
        }
      ]
    }
  ]
}
